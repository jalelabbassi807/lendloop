# Copy to .env.local for the Next.js app.

# written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# --- Convex deployment ---
# These are read by the Convex functions, so they go on the deployment, not in
# this file:  npx convex env set NAME value
#
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# ADMIN_EMAILS=you@example.com
# N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request
# CONVEX_TO_N8N_SECRET=     same value as in n8n/.env
# N8N_TO_CONVEX_SECRET=     same value as in n8n/.env
#
# n8n's own settings (secrets, SMTP, timezone) are in n8n/.env.example.
