# copy to n8n/.env
# Use the same two secrets as on the Convex deployment. To make one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONVEX_TO_N8N_SECRET=
N8N_TO_CONVEX_SECRET=

# Convex HTTP actions URL: https://<deployment>.convex.site, or for a local
# `convex dev` backend seen from Docker:
CONVEX_SITE_URL=http://host.docker.internal:3211

# Outgoing email. The defaults send to the Mailpit container from docker-compose
# (inbox at http://localhost:8025); put a real SMTP server here for production.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=LendLoop <no-reply@lendloop.local>

# the 09:00 reminder runs in this timezone
GENERIC_TIMEZONE=UTC
TZ=UTC
