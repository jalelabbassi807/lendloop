          "responseCode": 200
        }
      }
    },
    {
      "id": "8fa32d9c-2144-4e21-aef6-886072c999d0",
      "name": "Compose message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $json;\nconst dates = `${e.startDate} to ${e.endDate}`;\nconst text = {\n  request_created: `Someone asked to borrow your ${e.toolName} (${dates}). Open LendLoop to approve or decline.`,\n  approved: `Good news, your request for the ${e.toolName} (${dates}) was approved.`,\n  declined: `Your request for the ${e.toolName} (${dates}) was declined.`,\n  cancelled_by_borrower: `A request for your ${e.toolName} (${dates}) was cancelled.`,\n  returned: `The ${e.toolName} has been marked as returned. Thanks for borrowing!`,\n  listing_removed: `The ${e.toolName} listing was removed, so your request for ${dates} was cancelled.`,\n}[e.event] ?? 'One of your loans was updated.';\n\nreturn {\n  json: {\n    eventKey: e.eventKey,\n    loanId: e.loanId,\n    to: e.recipient.email,\n    subject: `LendLoop: ${e.toolName}`,\n    text: `Hi ${e.recipient.firstName},\\n\\n${text}\\n\\nLendLoop`,\n  },\n};"
      }
    },
    {
      "id": "5b56cff0-a90a-447d-9471-b86fa4cf69dd",
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.N8N_TO_CONVEX_SECRET;\nif (!secret) throw new Error('N8N_TO_CONVEX_SECRET is not set');\n\nconst body = JSON.stringify({\n  kind: 'request_notification',\n  status: $json.status,\n  loanId: $json.loanId,\n  idempotencyKey: $json.eventKey,\n  detail: $json.detail,\n});\nconst timestamp = String(Math.floor(Date.now() / 1000));\nconst signature = crypto.createHmac('sha256', secret).update(`${timestamp}.${body}`).digest('hex');\nreturn { json: { body, headers: { 'Content-Type': 'application/json', 'X-LendLoop-Timestamp': timestamp, 'X-LendLoop-Signature': signature } } };"
      }
    },
    {
