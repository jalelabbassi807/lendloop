    {
      "id": "ffcace5a-6889-417d-b5fe-8a7f227218d6",
      "name": "Verify HMAC signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\n\nconst { headers = {}, body } = $input.first().json;\nconst secret = $env.CONVEX_TO_N8N_SECRET;\nconst timestamp = headers['x-lendloop-timestamp'];\nconst signature = String(headers['x-lendloop-signature'] || '').toLowerCase();\n\n// Convex sends compact JSON, so re-stringifying gives the same bytes if there's no raw body\nlet raw;\ntry {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch {\n  raw = JSON.stringify(body);\n}\n\nfunction problem() {\n  if (!secret) return 'CONVEX_TO_N8N_SECRET is not set';\n  if (!timestamp || !signature) return 'missing signature headers';\n  const age = Math.abs(Date.now() / 1000 - Number(timestamp));\n  if (!(age <= 300)) return 'stale timestamp';\n  const expected = crypto.createHmac('sha256', secret).update(`${timestamp}.${raw}`).digest('hex');\n  if (expected.length !== signature.length) return 'bad signature';\n  if (!crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(signature))) return 'bad signature';\n  return null;\n}\n\nconst reason = problem();\nif (reason) return [{ json: { valid: false, reason } }];\n\nconst p = JSON.parse(raw);\nreturn [{\n  json: {\n    valid: true,\n    eventKey: p.eventKey,\n    event: p.event,\n    loanId: p.loanId,\n    toolName: p.toolName,\n    startDate: p.startDate,\n    endDate: p.endDate,\n    recipient: p.recipient,\n  },\n}];"
      }
    },
    {
      "id": "c9de7fb6-0ea4-44c8-b5b7-2e47c74efcd3",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "e606bd5f-4d01-497e-bcd4-4f38aac4f7c8",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6b4ce29a-9423-4f4a-97b8-4d73845b6ab1",
